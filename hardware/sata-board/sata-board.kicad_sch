	(
			"title_block"
			("title" "SATA power and interface board")
			("date" "2026-11-18")
			("rev" "1")
			("company" "sata-library")
			("comment" 1 "Power and I2C only. No SATA or USB pairs on this PCB.")
		)
	(
			"text"
			"XL4015 module has its own inductor. This board is not a discrete buck. Set the module to 5.1 V before connecting disks."
			("exclude_from_sim" no)
			("at" 20.32 317.5 0)
			("effects" ("font" ("size" 1.5 1.5)) ("justify" left bottom))
			("uuid" "b9aef461-9c6b-446a-8922-bbfae13ea5fd")
		)
	(
			"text"
			"PRESENT_N (J3 pin 3) is a track to GND, not a resistor. IO4-IO7 are inputs with 100k to GND, not motor outputs."
			("exclude_from_sim" no)
			("at" 20.32 307.34 0)
			("effects" ("font" ("size" 1.5 1.5)) ("justify" left bottom))
			("uuid" "b3d2f48b-877f-4ea4-ac2e-580af1dd61f4")
		)
	(
			"text"
			"IRF4905 high-side. Gate to source 100k = default OFF. 2N7002 pulls the gate down to turn a disk on. 5 V is not switched."
			("exclude_from_sim" no)
			("at" 20.32 297.18 0)
			("effects" ("font" ("size" 1.5 1.5)) ("justify" left bottom))
			("uuid" "564acf0f-a12e-419e-a8f2-4e90542e1a30")
		)
	(
			"text"
			"EEPROM map: bytes 0-3 SLIB, byte 4 = 1, byte 5 = 4, byte 6 = 1, rest 0. Blank from the fab. WP tied to GND."
			("exclude_from_sim" no)
			("at" 20.32 287.02 0)
			("effects" ("font" ("size" 1.5 1.5)) ("justify" left bottom))
			("uuid" "54d8b233-79a6-4103-93c3-4d952d65db30")
